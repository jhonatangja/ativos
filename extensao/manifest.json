{
  "manifest_version": 3,
  "name": "Ativo JMS",
  "version": "1.1.0",
  "description": "Endereço incorreto por motorista, telefone do cliente e atendimento guiado direto do JMS.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "scripting", "storage", "clipboardWrite"],
  "host_permissions": ["https://*.jtjms-br.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Ativo JMS",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "side_panel": { "default_path": "painel.html" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
